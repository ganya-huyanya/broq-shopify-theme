{% doc %}
  @prompt
    email enquery form 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-enquiry-form-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-enquiry-form__container-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .ai-enquiry-form__header-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-enquiry-form__title-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.title_size }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-enquiry-form__description-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.text_color }};
    opacity: 0.8;
    font-size: {{ block.settings.description_size }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-enquiry-form__fields-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-enquiry-form__field-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .ai-enquiry-form__label-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 500;
    color: {{ block.settings.text_color }};
  }

  .ai-enquiry-form__input-{{ ai_gen_id }},
  .ai-enquiry-form__textarea-{{ ai_gen_id }} {
    width: 100%;
    padding: 12px 16px;
    font-size: 14px;
    color: {{ block.settings.text_color }};
    background-color: {{ block.settings.input_background_color }};
    border: {{ block.settings.input_border_width }}px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    transition: border-color 0.2s ease;
  }

  .ai-enquiry-form__input-{{ ai_gen_id }}:focus,
  .ai-enquiry-form__textarea-{{ ai_gen_id }}:focus {
    outline: none;
    border-color: {{ block.settings.input_focus_border_color }};
  }

  .ai-enquiry-form__textarea-{{ ai_gen_id }} {
    min-height: 120px;
    resize: vertical;
  }

  .ai-enquiry-form__button-{{ ai_gen_id }} {
    padding: 14px 28px;
    font-size: 14px;
    font-weight: 600;
    color: {{ block.settings.button_text_color }};
    background-color: {{ block.settings.button_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    cursor: pointer;
    transition: background-color 0.2s ease;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-enquiry-form__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-enquiry-form__message-{{ ai_gen_id }} {
    padding: 12px 16px;
    border-radius: {{ block.settings.input_border_radius }}px;
    font-size: 14px;
  }

  .ai-enquiry-form__message--success-{{ ai_gen_id }} {
    background-color: #d4edda;
    color: #155724;
    border: 1px solid #c3e6cb;
  }

  .ai-enquiry-form__message--error-{{ ai_gen_id }} {
    background-color: #f8d7da;
    color: #721c24;
    border: 1px solid #f5c6cb;
  }

  @media screen and (max-width: 749px) {
    .ai-enquiry-form-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<div class="ai-enquiry-form-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {%- form 'contact' -%}
    <div class="ai-enquiry-form__container-{{ ai_gen_id }}">
      {% if block.settings.title != blank or block.settings.description != blank %}
        <div class="ai-enquiry-form__header-{{ ai_gen_id }}">
          {% if block.settings.title != blank %}
            <h2 class="ai-enquiry-form__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
          {% endif %}
          {% if block.settings.description != blank %}
            <div class="ai-enquiry-form__description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
          {% endif %}
        </div>
      {% endif %}

      <div class="ai-enquiry-form__fields-{{ ai_gen_id }}">
        {% if block.settings.show_name %}
          <div class="ai-enquiry-form__field-{{ ai_gen_id }}">
            <label for="ai-enquiry-name-{{ ai_gen_id }}" class="ai-enquiry-form__label-{{ ai_gen_id }}">
              Name{% if block.settings.name_required %} *{% endif %}
            </label>
            <input
              type="text"
              id="ai-enquiry-name-{{ ai_gen_id }}"
              name="contact[name]"
              class="ai-enquiry-form__input-{{ ai_gen_id }}"
              placeholder="{{ block.settings.name_placeholder }}"
              {% if block.settings.name_required %}required{% endif %}
              {% if form.errors %}
                aria-invalid="true"
              {% endif %}
            >
          </div>
        {% endif %}

        <div class="ai-enquiry-form__field-{{ ai_gen_id }}">
          <label for="ai-enquiry-email-{{ ai_gen_id }}" class="ai-enquiry-form__label-{{ ai_gen_id }}">
            Email *
          </label>
          <input
            type="email"
            id="ai-enquiry-email-{{ ai_gen_id }}"
            name="contact[email]"
            class="ai-enquiry-form__input-{{ ai_gen_id }}"
            placeholder="{{ block.settings.email_placeholder }}"
            autocomplete="email"
            autocorrect="off"
            autocapitalize="off"
            required
            {% if form.errors %}
              aria-invalid="true"
              aria-describedby="ai-enquiry-form-error-{{ ai_gen_id }}"
            {% endif %}
            {% if form.posted_successfully? %}
              aria-describedby="ai-enquiry-form-success-{{ ai_gen_id }}"
            {% endif %}
          >
        </div>

        {% if block.settings.show_phone %}
          <div class="ai-enquiry-form__field-{{ ai_gen_id }}">
            <label for="ai-enquiry-phone-{{ ai_gen_id }}" class="ai-enquiry-form__label-{{ ai_gen_id }}">
              Phone{% if block.settings.phone_required %} *{% endif %}
            </label>
            <input
              type="tel"
              id="ai-enquiry-phone-{{ ai_gen_id }}"
              name="contact[phone]"
              class="ai-enquiry-form__input-{{ ai_gen_id }}"
              placeholder="{{ block.settings.phone_placeholder }}"
              autocomplete="tel"
              {% if block.settings.phone_required %}required{% endif %}
            >
          </div>
        {% endif %}

        <div class="ai-enquiry-form__field-{{ ai_gen_id }}">
          <label for="ai-enquiry-message-{{ ai_gen_id }}" class="ai-enquiry-form__label-{{ ai_gen_id }}">
            Message *
          </label>
          <textarea
            id="ai-enquiry-message-{{ ai_gen_id }}"
            name="contact[body]"
            class="ai-enquiry-form__textarea-{{ ai_gen_id }}"
            placeholder="{{ block.settings.message_placeholder }}"
            required
          ></textarea>
        </div>
      </div>

      {% if form.posted_successfully? %}
        <div
          id="ai-enquiry-form-success-{{ ai_gen_id }}"
          class="ai-enquiry-form__message-{{ ai_gen_id }} ai-enquiry-form__message--success-{{ ai_gen_id }}"
        >
          {{ block.settings.success_message }}
        </div>
      {% endif %}

      {% if form.errors %}
        <div
          id="ai-enquiry-form-error-{{ ai_gen_id }}"
          class="ai-enquiry-form__message-{{ ai_gen_id }} ai-enquiry-form__message--error-{{ ai_gen_id }}"
        >
          {% for field in form.errors %}
            {{ form.errors.messages[field] }}
          {% endfor %}
        </div>
      {% endif %}

      <button type="submit" class="ai-enquiry-form__button-{{ ai_gen_id }}">
        {{ block.settings.button_text }}
      </button>
    </div>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Email enquiry form",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Title",
      "default": "Get in touch"
    },
    {
      "type": "inline_richtext",
      "id": "description",
      "label": "Description",
      "default": "Have a question? Send us a message and we'll get back to you soon."
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Description size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Form fields"
    },
    {
      "type": "checkbox",
      "id": "show_name",
      "label": "Show name field",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "name_required",
      "label": "Name required",
      "default": true
    },
    {
      "type": "text",
      "id": "name_placeholder",
      "label": "Name placeholder",
      "default": "Your name"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "your@email.com"
    },
    {
      "type": "checkbox",
      "id": "show_phone",
      "label": "Show phone field",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "phone_required",
      "label": "Phone required",
      "default": false
    },
    {
      "type": "text",
      "id": "phone_placeholder",
      "label": "Phone placeholder",
      "default": "Your phone number"
    },
    {
      "type": "text",
      "id": "message_placeholder",
      "label": "Message placeholder",
      "default": "Your message..."
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Send message"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thank you! We'll be in touch soon."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "input_background_color",
      "label": "Input background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "input_border_color",
      "label": "Input border",
      "default": "#e0e0e0"
    },
    {
      "type": "color",
      "id": "input_focus_border_color",
      "label": "Input focus border",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button background",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "button_hover_color",
      "label": "Button hover background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Form border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "input_border_radius",
      "label": "Input border radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "input_border_width",
      "label": "Input border width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Button border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Email enquiry form"
    }
  ]
}
{% endschema %}
