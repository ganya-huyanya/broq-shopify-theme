{"sections":{"text_nGPEUm":{"type":"text","settings":{"heading":"","content":"<p><strong>ABOUT US<\/strong><\/p><p>BROQ is a Kyiv-based jewellery brand. Founded 2019.<\/p><p>We make pieces that function as personal timestamps — objects tied to the moment of their choosing, not to trends or seasons. Each one is crafted from recycled 925 sterling silver, made to order, finished by hand. A piece begins when you decide it should exist.<\/p><p>A BROQ piece carries weight. Something you put on at a specific point in your life that stays with you from that moment forward — through everything that comes after. A talisman you acquire once and carry through.<\/p><p>It gains its real character with time. The scratches, the marks, the dull spots where your skin has worn the surface down — that's not damage. That's the piece becoming yours. No two wear the same way.<\/p><p>It doesn't tell people who you are. It reminds you who you were when you put it on.<\/p>","button_label":"","button_url":"","spacing_top":70,"spacing_bottom":70,"color_scheme":"color__bg-body","color_background":"#ffffff","color_text":"","color_border":"color__border-divider-1","color_button":"btn btn--tertiary","enable_color_fade":false,"style_border":"","style_text_alignment":"text-center","layout_x_alignment":"justify-center","layout_column_width":90,"enable_margin":false,"visibility":""}},"text_yxCLLJ":{"type":"text","settings":{"heading":"Media on broq","content":"","button_label":"","button_url":"","spacing_top":100,"spacing_bottom":0,"color_scheme":"color__bg-body","color_background":"#ffffff","color_text":"","color_border":"color__border-divider-1","color_button":"btn btn--secondary","enable_color_fade":false,"style_border":"","style_text_alignment":"","layout_x_alignment":"","layout_column_width":50,"enable_margin":true,"visibility":""}},"navigation_slider_hn7PT4":{"type":"navigation-slider","blocks":{"slide_DpgTtD":{"type":"slide","settings":{"image":"shopify:\/\/shop_images\/Frame_267.png","heading"