<style>
  .hover-gallery {
    padding: 40px 20px;
    text-align: center;
  }

  .hover-gallery h2 {
    font-size: 28px;
    margin-bottom: 10px;
  }

  .hover-gallery p {
    font-size: 16px;
    margin-bottom: 20px;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }

  .hover-gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
    gap: 4px;
    justify-items: center;
  }

  .hover-gallery-item {
    width: 100px;
    height: 175px;
    overflow: hidden;
    cursor: pointer;
    border-radius: 6px;
    transition: all 0.3s ease;
  }

  .hover-gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .hover-gallery-item:hover img {
    transform: scale(1.05);
  }

  .hover-gallery-button-wrapper {
    margin-top: 24px;
    display: flex;
    justify-content: center;
  }

  .hover-gallery-button {
    padding: 12px 28px;
    background: black;
    color: white;
    border-radius: 0px;
    text-decoration: none;
    font-size: 14px;
    display: inline-block;
  }

  .hover-gallery-item.opened {
    grid-column: span 3;
    width: 600px !important;
    height: 1065px !important;
    z-index: 10;
  }

  @media (max-width: 768px) {
    .hover-gallery-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .hover-gallery-item.opened {
      width: 100% !important;
      height: auto !important;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const items = document.querySelectorAll(".hover-gallery-item");

    items.forEach((item) => {
      item.addEventListener("click", () => {
        if (item.classList.contains("opened")) {
          item.classList.remove("opened");
        } else {
          items.forEach((i) => i.classList.remove("opened"));
          item.classList.add("opened");
        }
      });
    });
  });
</script>

<div class="hover-gallery">
  <h2>{{ section.settings.heading }}</h2>
  <p>{{ section.settings.text }}</p>
  <div class="hover-gallery-grid">
    {% for block in section.blocks %}
      <div class="hover-gallery-item">
        <img loading="lazy" src="{{ block.settings.image | img_url: 'master' }}" alt="">
      </div>
    {% endfor %}
  </div>
  {% if section.settings.button_label != blank and section.settings.button_link != blank %}
    <div class="hover-gallery-button-wrapper">
      <a href="{{ section.settings.button_link }}" class="hover-gallery-button">
        {{ section.settings.button_label }}
      </a>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Hover Gallery",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "NO BOT REVIEWS. NO FILTERS."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Just people who get it — and post it."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore more stories"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "max_blocks": 100,
  "presets": [
    {
      "name": "Hover Gallery",
      "category": "Image"
    }
  ]
}
{% endschema %}

