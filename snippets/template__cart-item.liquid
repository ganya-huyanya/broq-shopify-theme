<!-- snippets/template__cart-item.liquid -->
{% comment %}
  Cart item

  Usage:
    {% render 'template__cart-item' %}

  Globals:
  - type_seperator: {string} This sets the style for the divider between the cart items. It can be 'dot' or 'line'.
  - enable_animations: {boolean} This indicates whether animations should be used in the cart. If true, animations are enabled.

  Recommendations:
  - Must be used within a <template> tag with AlpineJS enabled
{% endcomment %}

<div class="bq-ci" :class="{ 'bq-ci--loading': cart_loading }">
  {% comment %} Image {% endcomment %}
  <a class="bq-ci__img" :href="item.url" tabindex="-1">
    <img
      width="160"
      height="160"
      loading="lazy"
      :src="`${ item.image }&width=320`"
      :alt="`${ item.product_title }`"
    >
  </a>

  <div class="bq-ci__body" x-data="{ properties_drop: false, button_loading: false }">
    <div class="bq-ci__top">
      <a class="bq-ci__title" :href="item.url" x-text="item.product_title"></a>
      <div class="bq-ci__price">
        <span x-html="Shopify.formatMoney(item.line_price)"></span>
        <s x-show="item.total_discount > 0" x-cloak x-html="Shopify.formatMoney(item.original_line_price)"></s>
      </div>
      <div class="bq-ci__meta" x-show="item.unit_price_measurement" x-cloak>
        <span x-html="Shopify.formatMoney(item.unit_price)"></span>
        <span>/</span>
        <span x-text="item.unit_price_measurement ? item.unit_price_measurement.reference_value : ''"></span>
        <span x-text="item.unit_price_measurement ? item.unit_price_measurement.reference_unit : ''"></span>
      </div>
      <p class="bq-ci__meta" x-text="item.variant_title" x-show="item.variant_title"></p>
      {% if section.settings.main_enable_cart_sku %}
        <p class="bq-ci__meta" x-text="item.sku" x-show="item.sku"></p>
      {% endif %}
      <p
        class="bq-ci__meta"
        x-text="item.selling_plan_allocation ? item.selling_plan_allocation.selling_plan.name : ''"
        x-show="item.selling_plan_allocation"
      ></p>
      <template x-for="(discount) in item.discounts">
        <p class="bq-ci__meta" x-html="discount.title + ' ' + Shopify.formatMoney(discount.amount)"></p>
      </template>
      <button
        class="bq-ci__link"
        type="button"
        x-show="item.properties && Object.keys(item.properties).length > 0 && !properties_drop"
        @click="properties_drop = ! properties_drop"
      >
        {{ 'actions.see_details' | t }}
      </button>
      <div x-show="properties_drop" x-cloak>
        <template x-if="item.properties">
          <template x-for="property in Object.entries(item.properties)">
            <template x-if="!property[0].startsWith('__') && !property[0].startsWith('_')">
              <p class="bq-ci__meta" x-text="property[0] + ' : ' + property[1]"></p>
            </template>
          </template>
        </template>
      </div>
      <button
        class="bq-ci__link"
        type="button"
        x-show="!item.product_has_only_default_variant"
        :disabled="button_loading"
        @click="
          button_loading = true;
          fetchAndRenderQuickEdit(item.handle, item.variant_id, item.quantity);
          setTimeout(function(){ button_loading = false}, 500);
        "
      >
        {{ 'actions.edit' | t }}
      </button>
    </div>

    {% comment %} Quantity and remove {% endcomment %}
    <div class="bq-ci__actions">
      <label class="sr-only" :for="'cart-' + item.key + '-quantity'">{{ 'labels.quantity' | t }}</label>
      <div class="bq-qty">
        <button
          class="bq-qty__btn"
          type="button"
          title="{{ 'actions.decrease_item_quantity' | t }}"
          aria-label="{{ 'actions.decrease_item_quantity' | t }}"
          :disabled="button_loading || item.quantity <= 1"
          @click.prevent="
            if (item.quantity > 1) {
              button_loading = true;
              changeCartItemQuantity(item.key, item.quantity - 1, false, false);
              setTimeout(function(){ button_loading = false }, 500);
            }
          "
        >
          {% render 'component__icon', icon: 'minus', size: '14', class: '' %}
        </button>
        <input
          class="bq-qty__input"
          :id="'cart-' + item.key + '-quantity'"
          type="number"
          min="1"
          inputmode="numeric"
          x-model="item.quantity"
          @change.debounce="
            changeCartItemQuantity(item.key, item.quantity, false);
            button_loading = true;
            setTimeout(function(){ button_loading = false }, 500);
          "
        >
        <button
          class="bq-qty__btn"
          type="button"
          title="{{ 'actions.increase_item_quantity' | t }}"
          aria-label="{{ 'actions.increase_item_quantity' | t }}"
          :disabled="button_loading"
          @click="
            button_loading = true;
            changeCartItemQuantity(item.key, item.quantity + 1, false, false);
            setTimeout(function(){ button_loading = false }, 500);
          "
        >
          {% render 'component__icon', icon: 'plus', size: '14', class: '' %}
        </button>
      </div>
      <button
        class="bq-ci__remove"
        type="button"
        title="{{ 'actions.delete' | t }}"
        aria-label="{{ 'actions.delete' | t }}"
        :disabled="button_loading"
        @click="
          button_loading = true;
          changeCartItemQuantity(item.key, 0, false);
          setTimeout(function(){ button_loading = false }, 500);
        "
      >
        {% render 'component__icon', icon: 'trash', size: '18', class: '' %}
      </button>
    </div>
  </div>
</div>
