<!-- snippets/product__availability.liquid -->
{% comment %}
  Availability status shown right after price: a colored dot + label
  ("IN STOCK" / "MADE TO ORDER"), with a smaller secondary line
  underneath giving the dispatch/production timeframe.

  Made-to-order is decided from a "made-to-order" product tag, set
  server-side via Liquid - NOT from the variant's inventory_quantity /
  inventory_policy. Those two fields are simply not present on the
  public storefront product JSON that Alpine reads from client-side
  (verified directly: fetching /products/<handle>.js returns
  inventory_management and available, but no inventory_quantity or
  inventory_policy on the variant objects) - so any client-side check
  against them silently evaluates to false/undefined, which is why the
  status was stuck on "IN STOCK" for every ring regardless of stock.

  Tag this product "made-to-order" in Shopify Admin to show the
  made-to-order state; otherwise it's treated as in stock. This is
  product-level (not per-variant), so it doesn't need to react to
  variant switches the way price/options do.

  Usage:
    {% render 'product__availability' %}
{% endcomment %}

{% assign is_made_to_order = false %}
{% if product.tags contains 'made-to-order' %}
  {% assign is_made_to_order = true %}
{% endif %}

<div
  class="px-4 mb-3"
  x-show="current_variant_exists && current_variant_available && all_options_selected"
  x-cloak
>
  <div class="flex items-center gap-2">
    <span
      class="inline-block h-2 w-2 rounded-full"
      style="background-color: {% if is_made_to_order %}#8a8a8a{% else %}#4caf50{% endif %};"
    ></span>
    <span class="type--small">
      {% if is_made_to_order %}
        MADE TO ORDER
      {% else %}
        IN STOCK
      {% endif %}
    </span>
  </div>
  <div class="type--small opacity-75 mt-1">
    {% if is_made_to_order %}
      (production takes 10 business days, then dispatched)
    {% else %}
      (dispatches within 2 business days)
    {% endif %}
  </div>
</div>
