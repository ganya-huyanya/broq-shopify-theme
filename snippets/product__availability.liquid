<!-- snippets/product__availability.liquid -->
{% comment %}
  Availability status shown right after price: a colored dot + label
  ("IN STOCK" / "MADE TO ORDER"), with a smaller secondary line
  underneath giving the dispatch/production timeframe.

  Reads real per-variant inventory from variant_inventory_map (built in
  script__product.liquid), keyed by current_variant_id - NOT from
  current_variant_inventory_quantity/policy, which go undefined the
  moment a customer switches variant (the public product JSON that
  refreshes them on switch doesn't include those two fields - verified
  live). variant_inventory_map is populated straight from Liquid, which
  does have the real numbers, so it stays correct across size/variant
  changes.

  Made-to-order = tracked inventory, 0 or less on hand, and policy set
  to "continue" (Shopify's own "continue selling when out of stock").

  Usage:
    {% render 'product__availability' %}
{% endcomment %}

<div
  class="px-4 mb-3"
  x-show="current_variant_exists && current_variant_available && all_options_selected"
  x-cloak
  x-data="{
    is_made_to_order() {
      const v = variant_inventory_map[current_variant_id];
      return !!v && v.tracked && v.qty <= 0 && v.policy == 'continue';
    }
  }"
>
  <div class="flex items-center gap-2">
    <span
      class="inline-block h-2 w-2 rounded-full"
      :style="is_made_to_order() ? 'background-color:#8a8a8a' : 'background-color:#4caf50'"
    ></span>
    <span
      class="type--small"
      x-text="is_made_to_order() ? {{ 'info.made_to_order_status' | t | json | escape }} : {{ 'info.in_stock_status' | t | json | escape }}"
    >
      {% comment %} No-JS fallback {% endcomment %}
      {{ 'info.in_stock_status' | t }}
    </span>
  </div>
  <div
    class="type--small opacity-75 mt-1"
    x-text="is_made_to_order() ? {{ 'info.made_to_order_detail' | t | json | escape }} : {{ 'info.in_stock_detail' | t | json | escape }}"
  >
    {{ 'info.in_stock_detail' | t }}
  </div>
</div>
