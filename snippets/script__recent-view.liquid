<!-- snippets/script__recent-view.liquid -->
{% comment %}
  This script is responsible for managing the recently viewed products feature on the Shopify store.
  It works by storing the product IDs of the recently viewed products in the local storage of the user's browser.

  Usage:
    {% render 'script__recent-view' %}

  Recommendations:
  - This script is best used in conjunction with a product detail page or any other section where a product is viewed.
  - The recently viewed products are stored in the local storage of the user's browser. Therefore, it is recommended to consider the user's privacy and data storage limitations when using this script.
{% endcomment %}

{% if template == 'product' %}
  <script
    type="module"
  >
    document.addEventListener('DOMContentLoaded', () => {

      let productHandle = "{{ product.handle }}"

      {% comment %}
        The cached entry carries the prices the product JSON returned at
        the moment it was viewed, so it also has to carry the currency
        they were quoted in - the slider renders them with whatever money
        format is active later, and a UAH amount drawn with a $ format
        reads as a wildly wrong price. Entries in another currency are
        filtered out on render (theme__scripts.liquid).
      {% endcomment %}
      let currency = "{{ cart.currency.iso_code }}"

      {% comment %} Always re-fetch, so a price change updates the cached copy {% endcomment %}
      fetch(`/products/${productHandle}.js`)
        .then(response => response.json())
        .then(data => {
          let stored = JSON.parse(localStorage.getItem('recentlyViewedProducts') || '[]')
          let others = stored.filter((prod) => prod.handle !== productHandle)
          let newProducts = [{ ...data, currency: currency }, ...others].slice(0, 12)
          localStorage.setItem("recentlyViewedProducts", JSON.stringify(newProducts))
        })
        .catch(err => console.log(err))

    });
  </script>
{% endif %}
